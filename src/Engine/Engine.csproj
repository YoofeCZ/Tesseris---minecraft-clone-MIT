<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Tesseris.Engine</RootNamespace>
    <AssemblyName>Tesseris.Engine</AssemblyName>

    <!--
      Vulkan se bez ukazatelu volat neda: struktury se retezi pres pNext, pole se predavaji
      jako pocet + ukazatel a SPIR-V modul chce ukazatel na uint32. Puvodni zduvodneni
      v Directory.Build.props ("nepotrebujeme, GL prebira pole") platilo pro OpenGL a
      portem na Vulkan prestalo platit.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenTK uz jen na okno, vstup a matematiku - GL vazby se nepouzivaji. -->
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="OpenTK" Version="4.9.4" />


    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
  </ItemGroup>

</Project>
