references/animalia/
references/mobs_animal/
references/mobs_monster/
references/mobs_redo/

# Nativni build (IrrlichtMt + most). Artefakty, ne zdrojaky.
build/

# Pracovní scratchpad sezení — mezivýsledky, ne výstup práce.
.scratch/
